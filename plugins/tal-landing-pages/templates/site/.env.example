# משתני הסביבה של האתר. כאן רק השמות, בלי ערכים.
# את הערכים האמיתיים מכניסים ב-Vercel (Settings > Environment Variables),
# או בקובץ .env.local לבדיקה במחשב. לעולם לא בקובץ הזה ולא בקוד.

# כתובת הוובהוק (למשל Make) שמקבלת כל ליד חדש
WEBHOOK_URL=

# גיבוי לידים ב-Vercel Blob. נוצר אוטומטית כשמחברים Blob לפרויקט ב-Vercel
BLOB_READ_WRITE_TOKEN=

# מזהה הפיקסל של מטא, לדפדפן. הפיקסל נטען רק אחרי הסכמה לעוגיות שיווק
NEXT_PUBLIC_META_PIXEL_ID=

# אותו מזהה פיקסל, לשרת (דיווח המרות דרך Conversions API)
META_PIXEL_ID=

# טוקן Conversions API של מטא. סודי, נשאר רק בשרת
META_CAPI_TOKEN=
